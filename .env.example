# Required for the private availability service.
ADMIN_API_KEY=
SESSION_SECRET=

# Optional: exact origins allowed to use cookie-authenticated admin API calls.
# Only needed for DIRECT cross-origin browser access, not the Next.js proxy.
ADMIN_ALLOWED_ORIGINS=

# Next.js server-side connection to the separately running Python service.
# Development defaults to http://127.0.0.1:5001. Required in production for admin.
# Example: https://your-availability-service.example.com (origin only, no path)
AVAILABILITY_API_URL=

# Optional advanced alternative: browser calls the Python service directly.
# Normally leave unset: same-origin Next.js proxy avoids cross-site cookie issues.
# This is PUBLIC configuration, never put an API key here.
NEXT_PUBLIC_AVAILABILITY_API_URL=

# Optional: controls requests to public hut booking pages.
REQUEST_PAUSE_SECONDS=2

# Optional: enable Airtable sync.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=AV1 Availability

# Google Sheets uses the connected Google Sheets integration in Replit.
# No Google API key is needed in this file.
