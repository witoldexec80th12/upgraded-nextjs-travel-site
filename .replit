run = "npm run dev"
modules = ["nodejs-20", "web", "bash", "postgresql-16", "python-base-3.13"]

[[ports]]
localPort = 3000
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5002
externalPort = 3000

[env]
PORT = "5000"

[nix]
channel = "stable-25_05"
packages = ["postgresql"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Availability API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "scraper-benchmark-offline"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Availability API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run --no-sync uvicorn hut_availability.app:app --host 0.0.0.0 --port 5001"
waitForPort = 5001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "scraper-benchmark-offline"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "env -u DATABASE_URL -u ADMIN_API_KEY -u SESSION_SECRET -u AIRTABLE_API_KEY -u AIRTABLE_BASE_ID -u GITHUB_TOKEN uv run --no-sync python -m unittest discover -s tests -p 'test_bukly.py' -v && env -u DATABASE_URL -u ADMIN_API_KEY -u SESSION_SECRET -u AIRTABLE_API_KEY -u AIRTABLE_BASE_ID -u GITHUB_TOKEN uv run --no-sync python -m unittest discover -s tests -p 'test_hut_availability.py' -v && env -u DATABASE_URL -u ADMIN_API_KEY -u SESSION_SECRET -u AIRTABLE_API_KEY -u AIRTABLE_BASE_ID -u GITHUB_TOKEN uv run --no-sync python -m unittest discover -s tests -p 'test_scraper_benchmark.py' -v && env -u DATABASE_URL -u ADMIN_API_KEY -u SESSION_SECRET -u AIRTABLE_API_KEY -u AIRTABLE_BASE_ID -u GITHUB_TOKEN uv run --no-sync python -m hut_availability.benchmark --max-requests 60 --max-seconds 180 --case-seconds 45 && git diff --check"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[userenv]

[userenv.shared]
